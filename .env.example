# Copy this file to ".env" (same folder) and fill in your key. ".env" is git-ignored.
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxx
# Optional: any OpenRouter model id (a small/cheap one is enough)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Optional: require this access code for everything (also needed before exposing the app to other machines)
# NETSCOPE_PASSWORD=choose-a-code
# Optional: AI calls per hour allowed in --share mode (default 40)
# NETSCOPE_AI_LIMIT=40
